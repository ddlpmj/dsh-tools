{
  "name": "dsh-deep-search",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AI 大搜索：使用搜索引擎直搜，按原始顺序呈现标题、链接与摘要。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deep-search",
    "research",
    "topic-dossier"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
