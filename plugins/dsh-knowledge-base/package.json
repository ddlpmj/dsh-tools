{
  "name": "dsh-knowledge-base",
  "version": "0.11.6",
  "private": true,
  "type": "module",
  "description": "Karpathy llm-wiki 风格知识库：上传任意常见格式文档或链接，自动编译成互相链接的本地 Wiki；支持内容管理（编辑、回收站、批量删除）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "knowledge-base",
    "wiki",
    "llm-wiki",
    "rag"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
